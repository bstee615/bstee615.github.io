---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import InlineMarkdown from "../../components/InlineMarkdown.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  math={post.data.math}
>
  <article class="post">
    <header>
      <h1><InlineMarkdown text={post.data.title} /></h1>
      <time datetime={post.data.date.toISOString()}>
        {
          post.data.date.toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
            timeZone: "UTC",
          })
        }
      </time>
    </header>
    {
      post.data.cover && (
        <figure class="post-cover">
          <img
            src={post.data.cover.srcMedium ?? post.data.cover.src}
            srcset={
              post.data.cover.srcMedium
                ? `${post.data.cover.srcMedium} 1100w, ${post.data.cover.src} 1520w`
                : undefined
            }
            sizes="(max-width: 760px) calc(100vw - 3rem), 760px"
            alt={post.data.cover.alt}
            width={post.data.cover.width}
            height={post.data.cover.height}
            decoding="async"
            fetchpriority="high"
          />
          {post.data.cover.credit && (
            <figcaption>
              Photo by {post.data.cover.credit.name}
              {post.data.cover.credit.id && ` (${post.data.cover.credit.id})`}
            </figcaption>
          )}
        </figure>
      )
    }
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    width: var(--page);
    margin: 0 auto;
    padding: var(--section-padding) 0;
  }

  .post > header,
  .post-cover,
  .body {
    max-width: 760px;
  }

  header {
    margin-bottom: var(--section-padding);
  }

  h1 {
    margin: 0.8rem 0 1.4rem;
    font-size: clamp(2.1rem, 5vw, 3.5rem);
  }

  time {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .post-cover {
    margin: 0 0 3rem;
  }

  .post-cover img {
    width: 100%;
    height: auto;
    max-height: 28rem;
    object-fit: cover;
    border-radius: var(--radius-box);
  }

  .post-cover figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: right;
  }

  .body {
    font-family: var(--font-sans);
    font-size: 1.18rem;
  }

  .body :global(pre) {
    margin: 1.75rem 0;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-box);
    color: var(--ink);
    background: var(--surface);
    box-shadow: inset 0 1px 0 color-mix(in oklch, var(--ink) 5%, transparent);
  }

  .body :global(pre code) {
    padding: 0;
    color: inherit;
    background: transparent;
    font-size: 1em;
    line-height: 1.6;
  }

  .body :global(.code-sample > pre) {
    margin: 0;
    padding-right: 5rem;
  }

  .body :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.75rem 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border: 1px solid var(--line);
    border-collapse: separate;
    border-radius: var(--radius-field);
    border-spacing: 0;
    font-size: 0.95em;
  }

  .body :global(th),
  .body :global(td) {
    padding: 0.7rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  .body :global(thead th) {
    background: var(--surface);
    font-weight: 750;
  }

  .body :global(tr + tr > *) {
    border-top: 1px solid var(--line);
  }

  .body :global(th + th),
  .body :global(td + td) {
    border-left: 1px solid var(--line);
  }

  @media (max-width: 600px) {
    .body {
      font-size: 1.08rem;
    }

    .body :global(th),
    .body :global(td) {
      padding: 0.6rem 0.75rem;
    }

    .body :global(.copy-code-button) {
      --btn-height: 2.5rem;
    }
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CvCitation from "../../components/CvCitation.astro";
import SocialIcon from "../../components/SocialIcon.astro";
import cv, { type CvEntry } from "../../data/cv";
import {
  externalLinks,
  organizations,
  projects,
  service,
  siteMetadata,
} from "../../data/site";
import { publicationPath } from "../../routes";
import { cvPublicationVenueTypes } from "../../utils/publications";

const publications = (await getCollection("publications"))
  .filter(
    ({ data }) =>
      cvPublicationVenueTypes.has(data.venueType) && !data.excludeFromCv,
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const paperVenueTypes = new Set([
  "conference-paper",
  "workshop-paper",
  "preprint",
]);
const selectedPublications = publications.filter(({ data }) => {
  const firstAuthor = siteMetadata.citationNames.some(
    (name) => name === data.authors[0],
  );
  return (
    paperVenueTypes.has(data.venueType) &&
    (firstAuthor || data.venue.toLowerCase() !== "arxiv")
  );
});
const selectedPublicationIds = new Set(
  selectedPublications.map(({ id }) => id),
);
const morePublications = publications.filter(
  ({ id }) => !selectedPublicationIds.has(id),
);
const withOrganizations = (entries: CvEntry[]) =>
  entries.map((entry) => ({
    ...entry,
    organization: organizations[entry.organizationId],
  }));
const positions = withOrganizations(cv.positions);
const education = withOrganizations(cv.education);
const primaryPositions = positions.filter((position) => !position.more);
const morePositions = positions.filter((position) => position.more);
const projectOrder = [
  "cfactor",
  "tree-climber",
  "pal-tools",
  "rrun",
  "wslwatch",
];
const selectedProjects = [
  {
    title: "DeepDFA",
    description: "Efficient, dataflow-inspired vulnerability detection",
    href: "https://github.com/ISU-PAAL/DeepDFA",
  },
  {
    title: "TRACED",
    description: "C/C++ execution tracing for model pre-training",
    href: "https://github.com/ARiSE-Lab/TRACED_ICSE_24/tree/main/tracer",
  },
  ...projectOrder.flatMap((title) => {
    const project = projects.find((item) => item.title === title);
    return project ? [project] : [];
  }),
];
const serviceByVenue = Array.from(
  service.reduce((groups, item) => {
    const key = `${item.role}|${item.name}|${item.url}`;
    const existing = groups.get(key) ?? { ...item, years: [] as number[] };
    existing.years.push(Number(item.date.slice(0, 4)));
    groups.set(key, existing);
    return groups;
  }, new Map<string, (typeof service)[number] & { years: number[] }>()),
  ([, item]) => item,
);
const formatYears = (years: number[]) =>
  [...new Set(years)].sort((a, b) => b - a).join(", ");
---

<BaseLayout title="CV" description="Curriculum vitae for Benjamin Steenhoek.">
  <article class="cv">
    <header class="cv-header">
      <div>
        <h1>{siteMetadata.name}</h1>
        <div class="cv-links">
          <a
            data-cv-email
            data-email-user="benjaminjsteenhoek"
            data-email-domain="gmail.com"
          >
            <SocialIcon name="email" />
            <span
              >benjaminjsteenhoek<span aria-hidden="true">@</span
              >gmail.com</span
            >
          </a>
          <a href={externalLinks.scholar}>
            <SocialIcon name="scholar" /> Scholar
          </a>
          <a href={externalLinks.github}>
            <SocialIcon name="github" /> github.com/bstee615
          </a>
          <a href={externalLinks.linkedin}>
            <SocialIcon name="linkedin" /> linkedin.com/in/ben-steenhoek
          </a>
        </div>
      </div>
      <a
        class="btn btn-secondary btn-sm"
        href="/files/benjamin-steenhoek-cv.pdf"
      >
        PDF
      </a>
    </header>

    <p class="cv-summary">
      AI/ML researcher building code-editing and agentic systems for software
      engineering. Current focus areas are LLM post-training and agent harness
      engineering. Research interests include agent evaluation, LLM fine-tuning,
      software security, and program analysis.<br />Based in Des Moines, Iowa.
    </p>

    <section>
      <h2>Experience</h2>
      <div class="cv-entries">
        {
          primaryPositions.map((position) => (
            <article class="cv-entry">
              <div class="cv-entry__heading">
                <h3>{position.title}</h3>
                {position.date && <time>{position.date}</time>}
              </div>
              <div class="cv-entry__meta">
                <span>
                  <a href={position.organization.url}>
                    {position.organization.name}
                  </a>
                </span>
                <span>{position.location}</span>
              </div>
              <div class="cv-details" set:html={position.bodyHtml} />
            </article>
          ))
        }
      </div>
      <details>
        <summary>More professional experience</summary>
        <div class="details-content">
          <div class="details-content__inner">
            <div class="cv-entries">
              {
                morePositions.map((position) => (
                  <article class="cv-entry">
                    <div class="cv-entry__heading">
                      <h3>{position.title}</h3>
                      {position.date && <time>{position.date}</time>}
                    </div>
                    <div class="cv-entry__meta">
                      <span>
                        <a href={position.organization.url}>
                          {position.organization.name}
                        </a>
                      </span>
                      <span>{position.location}</span>
                    </div>
                    <div class="cv-details" set:html={position.bodyHtml} />
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </details>
    </section>

    <section>
      <h2>Education</h2>
      <div class="cv-entries">
        {
          education.map((position) => (
            <article class="cv-entry">
              <div class="cv-entry__heading">
                <h3>{position.title}</h3>
                <time>{position.date}</time>
              </div>
              <div class="cv-entry__meta">
                <span>
                  <a href={position.organization.url}>
                    {position.organization.name}
                  </a>
                </span>
                <span>{position.location}</span>
              </div>
              <div class="cv-details" set:html={position.bodyHtml} />
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <div class="section-heading">
        <h2>Selected Publications</h2>
        <a href={externalLinks.scholar}>
          <SocialIcon name="scholar" /> See all on Google Scholar
        </a>
      </div>
      <ol class="cv-publications">
        {
          selectedPublications.map((publication) => (
            <li>
              <h3>
                <a href={publicationPath(publication.id)}>
                  {publication.data.title}
                </a>
                <span class="publication-links">
                  {publication.data.links.map((link) => (
                    <a class="btn btn-secondary btn-xs" href={link.url}>
                      {link.label}
                    </a>
                  ))}
                </span>
              </h3>
              <CvCitation citation={publication.data.citation} />
            </li>
          ))
        }
      </ol>
      <details>
        <summary>More publications</summary>
        <div class="details-content">
          <div class="details-content__inner">
            <ol class="cv-publications">
              {
                morePublications.map((publication) => (
                  <li>
                    <h3>
                      <a href={publicationPath(publication.id)}>
                        {publication.data.title}
                      </a>
                      <span class="publication-links">
                        {publication.data.links.map((link) => (
                          <a class="btn btn-secondary btn-xs" href={link.url}>
                            {link.label}
                          </a>
                        ))}
                      </span>
                    </h3>
                    <CvCitation citation={publication.data.citation} />
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </details>
    </section>

    <div class="cv-columns">
      <section>
        <h2>Invited Talks &amp; Service</h2>
        <ul class="cv-compact-list">
          {
            serviceByVenue.map((item) => (
              <li>
                <span>
                  <strong>{item.role}</strong> ·{" "}
                  <a href={item.url}>{item.name}</a>
                </span>
                <time>{formatYears(item.years)}</time>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <div class="section-heading">
          <h2>Selected Projects</h2>
          <a href={externalLinks.github}>
            <SocialIcon name="github" /> See all on GitHub
          </a>
        </div>
        <ul class="cv-compact-list cv-projects">
          {
            selectedProjects.map((project) => (
              <li>
                <a href={project.href}>
                  <strong>{project.title}</strong>
                </a>
                <span>— {project.description}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
  <script>
    document
      .querySelectorAll<HTMLElement>("[data-cv-email]")
      .forEach((link) => {
        const user = link.dataset.emailUser;
        const domain = link.dataset.emailDomain;
        if (link instanceof HTMLAnchorElement && user && domain) {
          link.href = `mailto:${user}@${domain}`;
        }
      });
  </script>
</BaseLayout>

<style>
  .cv {
    width: var(--page);
    margin: 0 auto;
    padding: var(--section-padding) 0;
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .cv-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .cv-header h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.03em;
  }

  .cv-header p {
    max-width: 52rem;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .cv-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .cv-links a,
  .section-heading > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .cv-links :global(svg),
  .section-heading :global(svg) {
    width: 0.9rem;
    min-width: 0.9rem;
    height: 0.9rem;
  }

  .cv-summary {
    margin-top: 1.25rem;
    padding: 0.8rem 0;
    border-top: var(--divider);
    color: var(--muted);
  }

  .cv section {
    margin-top: var(--section-padding);
  }

  .cv section > h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.35rem;
    border-bottom: var(--divider);
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: var(--divider);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-heading > a {
    flex: 0 0 auto;
    font-size: 0.78rem;
  }

  .cv-entries {
    display: grid;
    gap: 1.4rem;
  }

  .cv-entry__heading,
  .cv-entry__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .cv-entry h3,
  .cv-publications h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .cv-entry time,
  .cv-entry__meta span:last-child {
    flex: 0 0 auto;
    text-align: right;
  }

  .cv-entry__meta {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .cv :global(.cv-details ul),
  .cv-publications {
    margin: 0.55rem 0 0;
    padding-left: 1.2rem;
  }

  .cv :global(.cv-details ul) {
    list-style: disc;
    padding-left: 1.35rem;
  }

  .cv :global(.cv-details li),
  .cv-publications li {
    margin: 0.3rem 0;
  }

  details {
    margin-top: 1rem;
  }

  summary {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    cursor: pointer;
    color: var(--accent);
    font-weight: 800;
    touch-action: manipulation;
  }

  details[open] > .details-content > .details-content__inner {
    animation: details-reveal 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .details-content :where(.cv-entries, .cv-publications) {
    margin-top: 1rem;
  }

  @keyframes details-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cv-publications h3 {
    display: flex;
    align-items: flex-end;
    gap: 0.55rem;
    font-weight: 750;
    line-height: 1.35;
  }

  .cv-publications h3 > a:first-child {
    min-width: 0;
    flex: 1 1 auto;
  }

  .publication-links {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.45rem;
  }

  .publication-links a {
    font-size: 0.68rem;
    font-weight: 550;
    text-decoration: none;
    text-transform: uppercase;
  }

  .cv-columns {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.5rem;
  }

  .cv-compact-list {
    display: grid;
    gap: 0.55rem;
  }

  .cv-compact-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cv-compact-list time {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .cv-projects li {
    justify-content: flex-start;
  }

  .cv-projects a {
    flex: 0 0 auto;
  }

  .cv-projects span {
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .cv-header {
      flex-direction: column;
    }

    .cv-columns {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .cv-entry__heading,
    .cv-entry__meta {
      display: block;
    }

    .cv-entry time,
    .cv-entry__meta span {
      display: block;
      text-align: left;
    }

    .cv-publications h3 {
      align-items: flex-start;
      flex-direction: column;
    }

    .publication-links {
      flex-wrap: wrap;
    }

    .publication-links .btn {
      --btn-height: 2.5rem;
    }
  }

  @media print {
    .cv {
      width: 100%;
      padding: 0;
      color: #000;
      font-size: 9pt;
    }

    details {
      display: block;
    }

    details > summary {
      display: none;
    }

    .cv-entry,
    .cv-publications li {
      break-inside: avoid;
    }

    .cv section > h2 {
      break-after: avoid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] > .details-content > .details-content__inner {
      animation: none;
    }
  }
</style>

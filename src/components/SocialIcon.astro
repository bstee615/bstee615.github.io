---
interface Props {
  name: "scholar" | "linkedin" | "github" | "email";
}

const { name } = Astro.props;
const iconUrl = `/images/${name}.svg`;
---

<span
  class:list={{
    "social-icon": true,
    "social-icon--scholar": name === "scholar",
  }}
  aria-hidden="true"
  style={`--social-icon-url: url("${iconUrl}")`}></span>

<style>
  .social-icon {
    width: 1.05rem;
    min-width: 1.05rem;
    height: 1.05rem;
    background: currentColor;
    mask: var(--social-icon-url) center / contain no-repeat;
  }

  .social-icon--scholar {
    width: 1.15rem;
    min-width: 1.15rem;
    height: 1.15rem;
  }
</style>
